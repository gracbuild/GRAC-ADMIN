@model ControlManagement.Web.Models.RepositoryScreen
@{ ViewData["Title"]=Model.Title; var permissions = ViewBag.Permissions as string[] ?? []; }
<link rel="stylesheet" href="~/css/repository-actions.css" asp-append-version="true" />
@* Obligation tree-grids share the side-panel + preview styles defined for the matrix form. *@
@if(Model.Key=="obligation-mappings" || Model.Key=="obligations"){<link rel="stylesheet" href="~/css/obligation-mapping-form.css" asp-append-version="true" />}
<div class="page-heading"><div><p class="eyebrow">@(Model.Key.StartsWith("assurance-") ? "Assurance Management" : "Repository Management") / @Model.Title</p><h1 id="pageTitle">@Model.Title</h1><p>@Model.Description</p></div><div class="page-heading-actions"><button class="button" id="backToParent" type="button" hidden><i class="fa-solid fa-arrow-left"></i> Back</button>@* Phase 3: the "Manage Type Details" entry point was removed. Obligation type + typed detail are now captured on the merged Obligation Master form (Repository/ObligationMaster) and saved with the master in one approval bundle. *@@if(Model.Key!="audit-trace" && Model.Key!="change-management" && Model.Key!="source-control-mappings" && permissions.Contains("ADD")){<button class="button primary" id="addRecord"><i class="fa-solid fa-plus"></i> Add</button>}</div></div>
<section class="panel" data-screen="@Model.Key">
 <div class="toolbar"><input id="search" placeholder="Search repository..." /><select id="authority" hidden><option value="">All authorities</option></select><select id="artifact" hidden><option value="">All artifacts</option></select><select id="release" hidden><option value="">All releases</option></select><select id="changeModule" hidden><option value="">All modules</option></select><select id="changeActionType" hidden><option value="">All action types</option></select><select id="status"><option value="">All statuses</option></select><button class="button toolbar-icon-button" id="clearFilters" type="button" aria-label="Clear filters" title="Clear filters"><i class="fa-solid fa-filter-circle-xmark" aria-hidden="true"></i></button><button class="button toolbar-icon-button" id="refresh" type="button" aria-label="Refresh list" title="Refresh list"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i></button></div>
@{ var isTreeGrid = Model.Key=="source-structure" || Model.Key=="framework-statements" || Model.Key=="obligations" || Model.Key=="obligation-mappings" || Model.Key=="audit-trace"; }
  @* Project-wide grid standard (grac-grid.css): the body is locked to
     `--grac-grid-rows` rows so the grid never grows with the record count;
     everything beyond the visible page is reached through the pager below. *@
  <div class="grac-grid @(isTreeGrid ? "grac-grid--compact" : "")">
  <div class="table-wrap grac-grid-body @(isTreeGrid ? "tree-grid-wrap" : "")"><table><thead><tr>@foreach(var column in Model.Columns){<th>@(column switch { "EntityType" => "Module / Entity", "ModuleLabel" => "Module", "RecordReference" => "Record Name / Reference", "ActionType" => "Action Type", "FieldName" => "Field Changed", "FromValue" => "Old Value", "ToValue" => "New Value", "ChangedBy" => "Changed By", "ChangedOn" => "Changed On", "ObligationName" => "Obligation Name", "ExecutionFrequency" => "Execution Frequency", "AssuranceFrequency" => "Assurance Frequency", "RetentionRequirement" => "Retention Period", "RetentionPeriod" => "Retention Period", "EvidenceCount" => "Evidence", "MappingCount" => "Mappings", "LifecycleStatus" => "Lifecycle", "FormulaType" => "Formula Type", "RatingScale" => "Rating Scale", "PassThreshold" => "Pass Threshold", "SeverityRank" => "Rank", "StageCount" => "Stages", "SlaHours" => "SLA (hrs)", "SlaCode" => "SLA Code", "TimeBasis" => "Time Basis", "WarningPct" => "Warning %", "EscalationPct" => "Escalation %", "AnswerShape" => "Answer Shape", "RequiresEvidence" => "Requires Evidence", "IntervalDays" => "Interval (days)", "ReportScope" => "Scope", "ScoringModel" => "Scoring Model", "WorkflowTemplate" => "Workflow Template", "EntityId" => "Entity ID", "ActionCode" => "Action", "EnteredBy" => "Changed By", "EnteredDt" => "Changed On", _ => column })</th>}<th>Actions</th></tr></thead><tbody id="repositoryRows"><tr><td colspan="@(Model.Columns.Length+1)" class="empty">Loading...</td></tr></tbody></table></div>
  @* Single pager for every screen — markup is generated by GracPager. *@
  <div class="grac-pager" id="gridPager" hidden></div>
  </div>
</section>
<dialog id="recordDialog"><form id="recordForm"><div class="dialog-heading"><div><h2 id="dialogTitle">@Model.Title <span class="dialog-mode-chip" id="dialogModeChip" hidden>View Mode</span></h2><p id="dialogDescription">Maintain repository details.</p></div>@* Edit sits in the top-right of the heading, beside Close; Save/Cancel stay in the footer. *@<div class="dialog-heading-actions"><button type="button" class="button primary" id="editRecord" hidden><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit</button><button type="button" class="icon-button" id="closeRecord" aria-label="Close">x</button></div></div><div id="formMessage" class="form-message" hidden></div><div class="form-grid" id="recordFields"></div><div class="dialog-actions"><button type="button" class="button" id="cancelRecord">Cancel / Back</button><button type="button" class="button primary" id="saveRecord">Save</button></div></form></dialog>
@section Scripts { <script>window.cmScreen=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));window.cmApi="@ViewBag.ApiBaseUrl";window.cmPermissions=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(permissions));</script><script src="~/js/repository.js" asp-append-version="true"></script> }
